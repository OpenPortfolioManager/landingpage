---
// Win rate of the demo portfolio's closed positions (demo.json "closed", XTB's own profit per lot), counted the way the
// app does it (src/lib/analytics/winrate.ts there). Rendered final; motion.ts replays the count trade by trade.
import demo from "../data/demo.json";
import { HOME } from "../content/copy";
import { pct, signedMoney, type Lang } from "../lib/site";
import Avatar from "./Avatar.astro";
import Icon from "./Icon.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = HOME[lang].winrate;
const STEP = 420;

const trades = demo.closed;
const wins = trades.filter((t) => t.profit > 0).length;
const rate = wins / trades.length;
const sub = (w: number, n: number) => c.sub.replace("{w}", String(w)).replace("{n}", String(n));
const date = (iso: string) => new Intl.DateTimeFormat(lang === "pl" ? "pl-PL" : "en-GB", { day: "numeric", month: "short", year: "numeric" }).format(new Date(`${iso}T12:00:00Z`));

// Quarters with closed trades, oldest first (the app picks quarters for a range of 19 to 60 months).
const byQuarter = new Map<string, { trades: number; wins: number }>();
for (const t of trades) {
  const key = `${t.date.slice(0, 4)}-${Math.floor((Number(t.date.slice(5, 7)) - 1) / 3) + 1}`;
  const q = byQuarter.get(key) ?? { trades: 0, wins: 0 };
  q.trades++;
  if (t.profit > 0) q.wins++;
  byQuarter.set(key, q);
}
const quarters = [...byQuarter].map(([k, q]) => ({ label: c.quarter(Number(k.slice(5)), k.slice(0, 4)), rate: q.wins / q.trades }));
const chart = { w: 300, h: 110, top: 8 };
const bw = chart.w / quarters.length;
const yOf = (v: number) => chart.top + (1 - v) * (chart.h - chart.top);
---
<div class="glass-float rounded-[28px] p-5 sm:p-6" data-winrate data-animate data-step={STEP} data-lang={lang}>
  <div class="grid grid-cols-[minmax(0,1fr)] gap-5 sm:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
    <div>
      <div class="flex items-center gap-2.5">
        <span class="flex h-8 w-8 items-center justify-center rounded-[10px] bg-accent-soft text-accent"><Icon name="target" size={17} /></span>
        <span class="text-sm font-medium text-muted">{c.title}</span>
      </div>
      <div class="tabular mt-3 text-[clamp(40px,6vw,56px)] font-semibold leading-none tracking-[-0.04em]" data-wr-rate>{pct(rate, lang, 0)}</div>
      <div class="mt-2 text-sm text-ink-2" data-wr-sub data-tpl={c.sub}>{sub(wins, trades.length)}</div>
    </div>
    <div>
      <div class="flex items-baseline justify-between text-xs text-muted">
        <span>{c.byQuarter}</span>
        <span class="text-accent-2">{c.average} {pct(rate, lang, 0)}</span>
      </div>
      <svg viewBox={`0 0 ${chart.w} ${chart.h + 20}`} class="mt-2 block h-auto w-full" role="img" aria-label={`${c.title}, ${c.byQuarter.toLowerCase()}: ${quarters.map((q) => `${q.label} ${pct(q.rate, lang, 0)}`).join(", ")}`}>
        <line x1="0" x2={chart.w} y1={chart.h} y2={chart.h} stroke="var(--grid)"></line>
        {
          quarters.map((q, i) => (
            <rect x={i * bw + bw * 0.2} y={yOf(q.rate)} width={bw * 0.6} height={chart.h - yOf(q.rate)} rx="4" fill="var(--s1)" class="grow" style={`--d:${300 + i * 120}`}>
              <title>{`${q.label}: ${pct(q.rate, lang, 0)}`}</title>
            </rect>
          ))
        }
        <text x="0" y={chart.h + 17} font-size="13" fill="var(--muted)">{quarters[0].label}</text>
        <text x={chart.w} y={chart.h + 17} text-anchor="end" font-size="13" fill="var(--muted)">{quarters[quarters.length - 1].label}</text>
        <line x1="0" x2={chart.w} y1={yOf(rate)} y2={yOf(rate)} stroke="var(--accent-2)" stroke-width="1.4" stroke-dasharray="4 4" class="fill-fade"></line>
      </svg>
    </div>
  </div>

  <div class="mt-5 text-xs font-semibold uppercase tracking-[0.08em] text-muted">{c.list}</div>
  <ul class="mt-2 divide-y divide-line">
    {
      trades.map((t, i) => (
        <li class="pop-in flex items-center gap-3 py-2" style={`--d:${200 + i * STEP}`} data-wr-row data-win={t.profit > 0 ? "1" : "0"}>
          <Avatar ticker={t.ticker} size={30} />
          <span class="min-w-0 flex-1">
            <span class="block truncate text-sm font-medium">{t.name}</span>
            <span class="block text-[11px] text-muted">
              {date(t.date)} · {t.account}
            </span>
          </span>
          <span class:list={["tabular text-sm font-semibold", t.profit > 0 ? "text-gain" : "text-loss"]}>{signedMoney(t.profit, lang, 2, t.currency)}</span>
          <span class:list={["flex h-6 w-6 shrink-0 items-center justify-center rounded-full", t.profit > 0 ? "bg-gain/15 text-gain" : "bg-loss/15 text-loss"]}>
            <Icon name={t.profit > 0 ? "check" : "x"} size={13} stroke={3} />
          </span>
        </li>
      ))
    }
  </ul>
</div>

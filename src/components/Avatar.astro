---
// Instrument avatar like the app's: the bundled logo on white, else a monogram whose hue comes from the ticker.
// Decoration only; the ticker or name next to it carries the identity.
import { logo, tickerShort, tickerStyle } from "../lib/site";

interface Props {
  ticker: string;
  size?: number;
}
const { ticker, size = 34 } = Astro.props;
const src = logo(ticker);
---
{
  src ? (
    <span class="avatar avatar-logo" style={`width:${size}px;height:${size}px`} aria-hidden="true">
      <img src={src} alt="" width="96" height="96" loading="lazy" decoding="async" />
    </span>
  ) : (
    <span class="avatar" style={tickerStyle(ticker, size)} aria-hidden="true">
      {tickerShort(ticker)}
    </span>
  )
}

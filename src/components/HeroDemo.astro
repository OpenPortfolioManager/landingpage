<style>
  .scrollbar-none {
    scrollbar-width: none;
  }
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  [data-pane] {
    animation: pane-in 0.5s var(--ease-liquid);
  }
  @keyframes pane-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
  /* Typing indicator shows between the two messages, then makes room for the second one. */
  :global(.js) .typing {
    opacity: 0;
    height: 0;
    overflow: hidden;
  }
  :global(.js) [data-pane].in .typing {
    animation: typing 1.6s ease 0.4s both;
  }
  @keyframes typing {
    0% {
      opacity: 0;
      height: 20px;
    }
    15%,
    80% {
      opacity: 1;
      height: 20px;
    }
    100% {
      opacity: 0;
      height: 0;
    }
  }
  [aria-selected="true"] [data-progress] {
    animation: progress var(--interval, 7000ms) linear forwards;
  }
  [data-demo].paused [data-progress] {
    animation-play-state: paused;
  }
  [data-demo].manual [data-progress] {
    animation: none;
  }
  @keyframes progress {
    to {
      transform: scaleX(1);
    }
  }
</style>

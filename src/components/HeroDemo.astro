---
// The app, re-drawn from the demo portfolio's real numbers (computed by the app's own engine).
// Fully rendered at build time; src/scripts/motion.ts only animates it.
import demo from "../data/demo.json";
import { UI } from "../content/copy";
import { areaPath, linePath, money, num, pct, scale, signedMoney, signedPct, thin, tickerShort, tickerStyle, type Lang } from "../lib/site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = UI[lang].demo;
const T = demo.totals;

// ---- dashboard
const last52 = demo.timeline.slice(-52).map((p) => p[1] as number);
const spark = scale(last52, { w: 600, h: 120, pad: 8 });
const sparkLine = linePath(spark);
const sparkArea = areaPath(spark, 120);
const movers = [...demo.movers.slice(0, 3), ...demo.movers.slice(-2)];
const kpis = [
  { label: t.invested, value: T.invested, fmt: "money", tone: "" },
  { label: t.unrealized, value: T.unrealized, fmt: "smoney", tone: "text-gain" },
  { label: t.divs12, value: demo.dividends.ttmNet, fmt: "money", tone: "" },
  { label: t.xirr, value: T.xirr, fmt: "spct", tone: "text-gain" },
];
const fmt = (v: number, f: string, digits = 0) =>
  f === "money" ? money(v, lang, digits) : f === "smoney" ? signedMoney(v, lang, digits) : f === "spct" ? signedPct(v, lang, 2) : f === "pct" ? pct(v, lang, 2) : num(v, lang, digits);

// ---- benchmark (all history, weekly)
const tw = thin(demo.timeline.map((p) => p[3] as number));
const sp = thin(demo.benchmarks["S&P 500"].map((p) => p[1] as number));
const nd = thin(demo.benchmarks["Nasdaq-100"].map((p) => p[1] as number));
const all = [...tw, ...sp, ...nd];
const lo = Math.min(...all, 0);
const hi = Math.max(...all);
const box = { w: 1000, h: 300, pad: 12 };
const lines = [
  { key: "pf", name: t.portfolio, color: "var(--accent)", pts: scale(tw, box, lo, hi), end: tw[tw.length - 1], width: 3 },
  { key: "sp", name: "S&P 500", color: "var(--s2)", pts: scale(sp, box, lo, hi), end: sp[sp.length - 1], width: 2 },
  { key: "nd", name: "Nasdaq-100", color: "var(--s3)", pts: scale(nd, box, lo, hi), end: nd[nd.length - 1], width: 2 },
];
const yOf = (v: number) => box.pad + (1 - (v - lo) / (hi - lo)) * (box.h - box.pad * 2);
const grid = [0, 0.25, 0.5, 0.75, 1].filter((g) => g >= lo && g <= hi);
const years = [...new Set(demo.timeline.map((p) => String(p[0]).slice(0, 4)))].map((y) => ({
  y,
  x: (demo.timeline.findIndex((p) => String(p[0]).startsWith(y)) / (demo.timeline.length - 1)) * box.w,
}));

// ---- dividends
const months = demo.dividends.byMonth as Array<[string, number]>;
const maxDiv = Math.max(...months.map((m) => m[1]));
const MONTHS = lang === "pl" ? ["sty", "lut", "mar", "kwi", "maj", "cze", "lip", "sie", "wrz", "paź", "lis", "gru"] : ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const monthLabel = (m: string) => `${MONTHS[Number(m.slice(5, 7)) - 1]} ${m.slice(2, 4)}`;

// ---- import
const files = demo.imports.map((f) => ({ ...f, short: f.file.replace(/_2023-01-01_.*/, "") }));
const ops = demo.sampleOps.slice(0, 7);

// ---- alerts (the message format of src/lib/alerts/messages.ts in the app)
const nvda = demo.movers.find((m) => m.ticker === "NVDA.US")!;
const asOf = demo.asOf.split("-").reverse().join(".");
const plMoney = (x: number, ccy = "PLN", d = 0) => new Intl.NumberFormat("pl-PL", { style: "currency", currency: ccy, minimumFractionDigits: d, maximumFractionDigits: d }).format(x);
const plPct = (x: number, d = 2) => `${x >= 0 ? "+" : "−"}${new Intl.NumberFormat("pl-PL", { style: "percent", minimumFractionDigits: d, maximumFractionDigits: d }).format(Math.abs(x))}`;
const messages = [
  {
    time: lang === "pl" ? "pon., 22:47" : "Mon, 22:47",
    head: "portfoliomanager · 1 alert · 20.10.2026",
    lines: [`📉 Portfel: ${plPct(-0.024)} dziś (próg ±2,0%) · wartość ${plMoney(261245)}`],
  },
  {
    time: lang === "pl" ? "dziś, 22:41" : "Today, 22:41",
    head: `portfoliomanager · 2 alerty · ${asOf}`,
    lines: [
      `📈 NVIDIA (NVDA.US): ${plPct(nvda.dayPct)} dziś (próg ±2,0%) · cena ${plMoney(nvda.price, "USD", 2)}`,
      `💰 Portfel: wartość ${plMoney(T.value)} ≥ ${plMoney(250000)} · alert jednorazowy, wyłączony`,
    ],
  },
];

const tabs = (["dashboard", "import", "benchmark", "dividends", "alerts"] as const).map((k) => ({ k, title: t.tabs[k][0], sub: t.tabs[k][1] }));
const navIcons = [
  "M4 4h7v7H4zM13 4h7v4h-7zM13 10h7v10h-7zM4 13h7v7H4z",
  "M3 7h18v13H3zM16 13h2M3 7l3-4h12l3 4",
  "M4 19V5M4 19h16M8 15l3-4 3 2 5-6",
  "M12 3v18M8 7h6a3 3 0 0 1 0 6H9a3 3 0 0 0 0 6h7",
  "M5 4h14v16H5zM9 8h6M9 12h6M9 16h3",
  "M3 10h18M5 10v9M19 10v9M12 4l9 6H3z",
];
---
<div class="relative" data-demo data-interval="7000">
  <!-- tabs -->
  <div class="scrollbar-none -mx-4 mb-4 overflow-x-auto px-4 sm:mx-0 sm:px-0" role="tablist" aria-label={t.label}>
    <div class="glass-float mx-auto flex w-max min-w-full gap-1 rounded-[22px] p-1.5 sm:w-full">
      {
        tabs.map((tab, i) => (
          <button
            type="button"
            role="tab"
            id={`demo-tab-${tab.k}`}
            aria-controls={`demo-pane-${tab.k}`}
            aria-selected={i === 0 ? "true" : "false"}
            data-tab={tab.k}
            class="group relative flex min-w-[150px] flex-1 flex-col items-start overflow-hidden rounded-2xl px-3.5 py-2.5 text-left transition-colors aria-selected:pill-active hover:bg-white/5"
          >
            <span class="text-[13px] font-semibold text-ink-2 group-aria-selected:text-ink">{tab.title}</span>
            <span class="text-[11.5px] text-muted">{tab.sub}</span>
            <span class="absolute inset-x-3 bottom-1 h-[2px] overflow-hidden rounded-full bg-white/5">
              <span data-progress class="block h-full w-full origin-left scale-x-0 rounded-full bg-accent" />
            </span>
          </button>
        ))
      }
    </div>
  </div>

  <!-- window -->
  <div class="glass-float overflow-hidden rounded-[28px]">
    <div class="flex items-center gap-3 border-b border-line px-4 py-3">
      <div class="flex gap-1.5" aria-hidden="true">
        <span class="h-3 w-3 rounded-full bg-white/10"></span><span class="h-3 w-3 rounded-full bg-white/10"></span><span class="h-3 w-3 rounded-full bg-white/10"></span>
      </div>
      <div class="inset mx-auto flex min-w-0 items-center gap-2 rounded-full px-3 py-1 text-xs text-muted">
        <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V7a4 4 0 0 1 8 0v4"></path></svg>
        <span class="truncate">{t.window}</span>
      </div>
      <span class="hidden items-center gap-1.5 rounded-full bg-accent-soft px-2.5 py-1 text-[11px] font-semibold text-accent sm:inline-flex">{t.label}</span>
    </div>

    <div class="flex min-h-[480px]">
      <!-- mini sidebar -->
      <div class="hidden w-14 shrink-0 flex-col items-center gap-2 border-r border-line py-4 md:flex" aria-hidden="true">
        {
          navIcons.map((d, i) => (
            <span class:list={["flex h-9 w-9 items-center justify-center rounded-xl", i === 0 ? "pill-active text-accent" : "text-muted"]}>
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                <path d={d} />
              </svg>
            </span>
          ))
        }
      </div>

      <div class="relative min-w-0 flex-1 p-4 sm:p-6">
        <!-- ============ dashboard ============ -->
        <section id="demo-pane-dashboard" role="tabpanel" aria-labelledby="demo-tab-dashboard" data-pane="dashboard">
          <div class="grid grid-cols-[minmax(0,1fr)] gap-4 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)]">
            <div class="glass relative overflow-hidden px-5 pt-5">
              <div class="pointer-events-none absolute -right-16 -top-24 h-64 w-64 rounded-full bg-[radial-gradient(circle,rgba(158,140,255,.35),transparent_68%)]"></div>
              <div class="flex items-center justify-between">
                <span class="text-sm text-muted">{t.value}</span>
                <span class="inline-flex items-center gap-1.5 rounded-full bg-gain/12 px-2 py-0.5 text-[11px] font-semibold text-gain"><span class="live-dot !h-1.5 !w-1.5"></span>{t.live}</span>
              </div>
              <div class="tabular mt-2 text-[clamp(34px,5vw,52px)] font-semibold leading-none tracking-[-0.04em]" data-count={T.value} data-fmt="money" data-lang={lang}>
                {money(T.value, lang)}
              </div>
              <div class="mt-3.5 flex flex-wrap items-center gap-2 text-sm">
                <span class="tabular rounded-full bg-gain/12 px-2 py-0.5 text-xs font-semibold text-gain">{signedMoney(T.dayChange, lang, 2)}</span>
                <span class="tabular rounded-full bg-gain/12 px-2 py-0.5 text-xs font-semibold text-gain">{signedPct(T.dayChangePct, lang)}</span>
                <span class="text-muted">{t.today}</span>
              </div>
              <div class="mt-2 text-sm">
                <span class="text-muted">{t.total}</span>
                <span class="tabular ml-2 font-semibold text-gain" data-count={T.pnl} data-fmt="smoney" data-lang={lang}>{signedMoney(T.pnl, lang)}</span>
                <span class="tabular ml-1.5 text-gain">{signedPct(T.pnlPct, lang)}</span>
              </div>
              <svg viewBox="0 0 600 120" class="-mx-5 mt-4 block h-auto w-[calc(100%+2.5rem)]" aria-hidden="true">
                <defs>
                  <linearGradient id="spark-fill" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#3987e5" stop-opacity="0.38"></stop>
                    <stop offset="100%" stop-color="#3987e5" stop-opacity="0"></stop>
                  </linearGradient>
                </defs>
                <path d={sparkArea} fill="url(#spark-fill)" class="fill-fade"></path>
                <path d={sparkLine} fill="none" stroke="#3987e5" stroke-width="2.5" pathLength="1" class="draw"></path>
              </svg>
            </div>
            <div class="glass p-4">
              <div class="mb-2 px-1 text-sm font-semibold">{t.movers}</div>
              <ul class="space-y-0.5" data-live>
                {
                  movers.map((m, i) => (
                    <li
                      class="pop-in flex items-center gap-3 rounded-2xl px-2 py-1.5"
                      style={`--d:${200 + i * 90}`}
                      data-row
                      data-price={m.price}
                      data-pct={m.dayPct}
                      data-val={m.dayValue}
                      data-ccy={m.currency}
                    >
                      <span class="avatar" style={tickerStyle(m.ticker, 34)} aria-hidden="true">
                        {tickerShort(m.ticker)}
                      </span>
                      <span class="min-w-0 flex-1">
                        <span class="flex items-center gap-1.5 text-sm font-semibold">
                          {m.ticker}
                          <span data-pct-out class:list={["text-xs font-medium", m.dayPct >= 0 ? "text-gain" : "text-loss"]}>
                            {signedPct(m.dayPct, lang)}
                          </span>
                        </span>
                        <span class="block truncate text-xs text-muted">{m.name}</span>
                      </span>
                      <span class="text-right">
                        <span data-val-out class:list={["tabular block text-sm font-semibold", m.dayValue >= 0 ? "text-gain" : "text-loss"]}>
                          {signedMoney(m.dayValue, lang, 2)}
                        </span>
                        <span data-price-out class="tabular block text-[11px] text-muted">
                          {money(m.price, lang, 2, m.currency)}
                        </span>
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
          <div class="mt-4 grid grid-cols-2 gap-3 lg:grid-cols-4">
            {
              kpis.map((k, i) => (
                <div class="glass pop-in px-4 py-3.5" style={`--d:${500 + i * 80}`}>
                  <div class="text-xs text-muted">{k.label}</div>
                  <div class:list={["tabular mt-1.5 text-lg font-semibold tracking-[-0.02em] sm:text-xl", k.tone]} data-count={k.value} data-fmt={k.fmt} data-lang={lang}>
                    {fmt(k.value, k.fmt)}
                  </div>
                </div>
              ))
            }
          </div>
        </section>

        <!-- ============ import ============ -->
        <section id="demo-pane-import" role="tabpanel" aria-labelledby="demo-tab-import" data-pane="import" hidden>
          <div class="grid grid-cols-[minmax(0,1fr)] gap-4 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.2fr)]">
            <div class="glass p-4">
              <div class="flex flex-col items-center justify-center rounded-[18px] border-2 border-dashed border-line-strong bg-white/[.02] px-4 py-6 text-center">
                <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-accent-soft text-accent">
                  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path><path d="M14 3v5h5M9 13h6M9 17h6"></path></svg>
                </span>
                <p class="mt-3 text-sm font-semibold">{t.dropTitle}</p>
                <p class="mt-1 max-w-xs text-xs text-muted">{t.dropNote}</p>
              </div>
              <ul class="mt-4 space-y-2.5">
                {
                  files.map((f, i) => (
                    <li class="pop-in inset rounded-2xl px-3.5 py-3" style={`--d:${250 + i * 450}`}>
                      <div class="flex items-center gap-2.5">
                        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-[#1d6f42] text-[10px] font-bold text-white">XLSX</span>
                        <span class="min-w-0 flex-1">
                          <span class="block truncate text-[13px] font-medium">{f.short}.xlsx</span>
                          <span class="block text-[11px] text-muted">
                            {t.parsed}: <b class="tabular font-semibold text-ink-2" data-count={f.cashOps} data-fmt="int" data-lang={lang}>{f.cashOps}</b> {t.ops} · {f.closedLots} {t.closed} · {f.openLots} {t.open}
                          </span>
                        </span>
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="var(--gain)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="m8 12 3 3 5-6"></path></svg>
                      </div>
                      <span class="mt-2.5 block h-1 overflow-hidden rounded-full bg-white/5">
                        <span class="grow-x block h-full rounded-full bg-gradient-to-r from-accent-deep to-accent" style={`--d:${350 + i * 450}`} />
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="glass overflow-hidden p-4">
              <div class="mb-3 px-1 text-sm font-semibold">{t.preview} · XTB PLN</div>
              <div class="overflow-x-auto">
                <table class="tabular w-full min-w-[440px] text-[12.5px]">
                  <thead>
                    <tr class="text-left text-[10.5px] uppercase tracking-[0.08em] text-muted">
                      <th class="px-2 py-2 font-semibold">{t.colTime}</th>
                      <th class="px-2 py-2 font-semibold">{t.colType}</th>
                      <th class="px-2 py-2 font-semibold">{t.colSymbol}</th>
                      <th class="px-2 py-2 text-right font-semibold">{t.colAmount}</th>
                    </tr>
                  </thead>
                  <tbody>
                    {
                      ops.map((o, i) => (
                        <tr class="pop-in border-t border-line" style={`--d:${1300 + i * 110}`}>
                          <td class="whitespace-nowrap px-2 py-2 text-muted">{o.time.slice(0, 16)}</td>
                          <td class="whitespace-nowrap px-2 py-2">{o.type}</td>
                          <td class="px-2 py-2 text-ink-2">{o.symbol || "–"}</td>
                          <td class:list={["whitespace-nowrap px-2 py-2 text-right font-medium", o.amount >= 0 ? "text-gain" : "text-ink"]}>
                            {o.amount >= 0 ? "+" : "−"}
                            {num(Math.abs(o.amount), lang, 2)} PLN
                          </td>
                        </tr>
                      ))
                    }
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </section>

        <!-- ============ benchmark ============ -->
        <section id="demo-pane-benchmark" role="tabpanel" aria-labelledby="demo-tab-benchmark" data-pane="benchmark" hidden>
          <div class="glass p-4 sm:p-5">
            <div class="flex flex-wrap items-end justify-between gap-3">
              <div>
                <div class="text-sm font-semibold">{t.benchTitle}</div>
                <div class="text-xs text-muted">{t.benchNote}</div>
              </div>
              <div class="flex flex-wrap gap-2 text-xs">
                {
                  lines.map((l) => (
                    <span class="inline-flex items-center gap-1.5 rounded-full border border-line-strong bg-white/[.03] px-2.5 py-1">
                      <span class="inline-block h-0.5 w-3.5 rounded-full" style={`background:${l.color}`} />
                      {l.name}
                      <b class="tabular font-semibold text-gain" data-count={l.end} data-fmt="spct" data-digits="1" data-lang={lang}>
                        {signedPct(l.end, lang, 1)}
                      </b>
                    </span>
                  ))
                }
              </div>
            </div>
            <svg viewBox={`0 0 ${box.w} ${box.h + 24}`} class="mt-4 block h-auto w-full" role="img" aria-label={t.benchTitle}>
              {
                grid.map((g) => (
                  <g>
                    <line x1="0" x2={box.w} y1={yOf(g)} y2={yOf(g)} stroke="var(--grid)" stroke-width="1" />
                    <text x="4" y={yOf(g) - 5} fill="var(--muted)" font-size="13">
                      {signedPct(g, lang, 0)}
                    </text>
                  </g>
                ))
              }
              {years.map((y) => <text x={Math.min(y.x + 4, box.w - 40)} y={box.h + 18} fill="var(--muted)" font-size="13">{y.y}</text>)}
              {
                lines.map((l, i) => (
                  <path d={linePath(l.pts)} fill="none" stroke={l.color} stroke-width={l.width} stroke-linejoin="round" pathLength="1" class="draw" style={`--d:${i * 180}`} />
                ))
              }
            </svg>
          </div>
        </section>

        <!-- ============ dividends ============ -->
        <section id="demo-pane-dividends" role="tabpanel" aria-labelledby="demo-tab-dividends" data-pane="dividends" hidden>
          <div class="grid grid-cols-[minmax(0,1fr)] gap-4 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)]">
            <div class="glass p-4 sm:p-5">
              <div class="text-sm font-semibold">{t.divTitle}</div>
              <div class="text-xs text-muted">PLN · 24 {lang === "pl" ? "miesiące" : "months"}</div>
              <svg viewBox="0 0 720 260" class="mt-4 block h-auto w-full" role="img" aria-label={t.divTitle}>
                <line x1="0" x2="720" y1="236" y2="236" stroke="var(--grid)"></line>
                {
                  months.map(([m, v], i) => {
                    const w = 720 / months.length;
                    const h = Math.max(2, (v / maxDiv) * 220);
                    return (
                      <g>
                        <rect x={i * w + w * 0.18} y={236 - h} width={w * 0.64} height={h} rx="4" fill="#3987e5" class="grow" style={`--d:${i * 35}`}>
                          <title>{`${monthLabel(m)}: ${money(v, lang, 2)}`}</title>
                        </rect>
                        {i % 6 === 0 && (
                          <text x={i * w + w / 2} y="256" text-anchor="middle" fill="var(--muted)" font-size="12">
                            {monthLabel(m)}
                          </text>
                        )}
                      </g>
                    );
                  })
                }
              </svg>
            </div>
            <div class="grid gap-4">
              <div class="grid grid-cols-2 gap-3">
                <div class="glass px-4 py-3.5">
                  <div class="text-xs text-muted">{t.divTtm}</div>
                  <div class="tabular mt-1.5 text-xl font-semibold" data-count={demo.dividends.ttmNet} data-fmt="money" data-lang={lang}>{money(demo.dividends.ttmNet, lang)}</div>
                </div>
                <div class="glass px-4 py-3.5">
                  <div class="text-xs text-muted">{t.divTotal}</div>
                  <div class="tabular mt-1.5 text-xl font-semibold" data-count={demo.dividends.totalNet} data-fmt="money" data-lang={lang}>{money(demo.dividends.totalNet, lang)}</div>
                </div>
              </div>
              <div class="glass p-4">
                <div class="mb-2 text-sm font-semibold">{t.topPayers}</div>
                <ul class="space-y-2">
                  {
                    demo.dividends.top.slice(0, 4).map((d, i) => (
                      <li class="pop-in flex items-center gap-3" style={`--d:${300 + i * 120}`}>
                        <span class="avatar" style={tickerStyle(d.ticker, 30)} aria-hidden="true">
                          {tickerShort(d.ticker)}
                        </span>
                        <span class="min-w-0 flex-1 truncate text-sm">{d.name}</span>
                        <span class="tabular text-sm font-semibold">{money(d.net, lang)}</span>
                      </li>
                    ))
                  }
                </ul>
              </div>
            </div>
          </div>
        </section>

        <!-- ============ alerts ============ -->
        <section id="demo-pane-alerts" role="tabpanel" aria-labelledby="demo-tab-alerts" data-pane="alerts" hidden>
          <div class="glass overflow-hidden">
            <div class="flex items-center gap-2 border-b border-line px-4 py-3 text-sm">
              <span class="text-lg text-muted">#</span>
              <span class="font-semibold">{t.channel.replace("#", "")}</span>
              <span class="ml-auto hidden text-xs text-muted sm:inline">Discord</span>
            </div>
            <div class="space-y-5 p-4 sm:p-5">
              {

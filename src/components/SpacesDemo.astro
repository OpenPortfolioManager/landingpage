---
// Spaces switcher as in the app's sidebar: each space is its own portfolio with its own imports, alerts and public
// page. Panes switch on their own (data-cycle in src/scripts/motion.ts); the lines are only shapes, no amounts.
import demo from "../data/demo.json";
import { HOME } from "../content/copy";
import { linePath, scale, thin, type Lang } from "../lib/site";
import Icon from "./Icon.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = HOME[lang].spaces;

const day = (offset: number) =>
  new Intl.DateTimeFormat(lang === "pl" ? "pl-PL" : "en-GB", lang === "pl" ? { day: "2-digit", month: "2-digit", year: "numeric" } : { day: "numeric", month: "short", year: "numeric" }).format(
    new Date(Date.parse(`${demo.asOf}T12:00:00Z`) - offset * 864e5),
  );
const series = [
  demo.timeline.slice(-104).map((p) => p[1] as number),
  demo.benchmarks["S&P 500"].slice(-104).map((p) => p[1] as number),
  demo.benchmarks["Nasdaq-100"].slice(-60).map((p) => p[1] as number),
];
const spaces = c.items.map((s, i) => ({
  ...s,
  imported: day([0, 3, 8][i]),
  path: linePath(scale(thin(series[i], 60), { w: 300, h: 64, pad: 6 })),
}));
---
<div class="glass-float rounded-[28px] p-4 sm:p-5" data-cycle data-interval="3800">
  <div class="grid grid-cols-[minmax(0,1fr)] gap-4 sm:grid-cols-[minmax(0,0.8fr)_minmax(0,1.3fr)]">
    <div>
      <div class="px-2 pb-2 text-[11px] font-semibold uppercase tracking-[0.08em] text-muted">{c.label}</div>
      <div role="tablist" aria-label={c.label} aria-orientation="vertical" class="space-y-1">
        {
          spaces.map((s, i) => (
            <button
              type="button"
              role="tab"
              id={`space-tab-${i}`}
              aria-controls={`space-pane-${i}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
              data-cycle-btn
              class="relative flex w-full items-center gap-2.5 overflow-hidden rounded-xl px-2.5 py-2 text-left text-sm text-ink-2 transition-colors hover:bg-white/5 aria-selected:pill-active aria-selected:text-ink"
            >
              <Icon name="spaces" size={15} class="shrink-0 text-accent" />
              <span class="truncate font-medium">{s.name}</span>
              <span class="absolute inset-x-2.5 bottom-0.5 h-[2px] overflow-hidden rounded-full">
                <span data-progress class="block h-full w-full origin-left scale-x-0 rounded-full bg-accent/70" />
              </span>
            </button>
          ))
        }
      </div>
      <div class="mt-1 flex items-center gap-2.5 rounded-xl border border-dashed border-line-strong px-2.5 py-2 text-sm text-muted" aria-hidden="true">
        <Icon name="plus" size={15} class="shrink-0" />
        {c.newSpace}
      </div>
    </div>

    <div class="inset min-h-[262px] rounded-[20px] p-4">
      {
        spaces.map((s, i) => (
          <section id={`space-pane-${i}`} role="tabpanel" aria-labelledby={`space-tab-${i}`} data-cycle-pane data-replay hidden={i !== 0}>
            <div class="pop-in text-lg font-semibold tracking-[-0.02em]" style="--d:0">
              {s.name}
            </div>
            <svg viewBox="0 0 300 64" class="mt-2 block h-auto w-full" aria-hidden="true">
              <path d={s.path} fill="none" stroke="var(--accent)" stroke-width="2.2" stroke-linejoin="round" pathLength="1" class="draw" />
            </svg>
            <dl class="mt-2 divide-y divide-line text-[13px]">
              <div class="pop-in flex items-center justify-between gap-3 py-2" style="--d:120">
                <dt class="text-muted">{c.rows.accounts}</dt>
                <dd class="flex flex-wrap justify-end gap-1">
                  {s.accounts.map((a) => (
                    <span class="rounded-full bg-accent-soft px-2 py-0.5 text-[11px] font-semibold text-accent-2">{a}</span>
                  ))}
                </dd>
              </div>
              <div class="pop-in flex items-center justify-between gap-3 py-2" style="--d:220">
                <dt class="text-muted">{c.rows.import}</dt>
                <dd class="text-right text-ink-2">
                  {c.reportOf} {s.imported}
                </dd>
              </div>
              <div class="pop-in flex items-center justify-between gap-3 py-2" style="--d:320">
                <dt class="text-muted">{c.rows.alerts}</dt>
                <dd class="text-right text-ink-2">{s.alerts}</dd>
              </div>
              <div class="pop-in flex items-center justify-between gap-3 py-2" style="--d:420">
                <dt class="shrink-0 text-muted">{c.rows.public}</dt>
                <dd class="flex min-w-0 justify-end">
                  {s.public ? (
                    <span class="flex min-w-0 items-center gap-1.5 text-ink">
                      <span class="live-dot !h-1.5 !w-1.5 shrink-0" />
                      <span class="truncate">{s.public}</span>
                    </span>
                  ) : (
                    <span class="text-muted">{c.off}</span>
                  )}
                </dd>
              </div>
            </dl>
          </section>
        ))
      }
    </div>
  </div>
</div>

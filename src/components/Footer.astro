---
import { UI } from "../content/copy";
import { PAGES } from "../content/pages";
import { APP_LOGIN, REPO_URL, route, type Lang, type RouteKey } from "../lib/site";
import Logo from "./Logo.astro";

interface Props {
  lang: Lang;
  page: RouteKey;
}
const { lang, page } = Astro.props;
const t = UI[lang].footer;
const other: Lang = lang === "en" ? "pl" : "en";
const guides = (["dividends", "tax", "benchmark", "public"] as const).map((k) => ({ href: route(k, lang), label: PAGES[k][lang].crumb }));
const year = new Date().getFullYear();
---
<footer class="mt-24 border-t border-line">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 sm:px-8 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div>
      <a href={route("home", lang)} class="flex items-center gap-2.5">
        <Logo class="h-7 w-auto" />
        <span class="text-[17px] font-semibold tracking-[-0.02em]">portfolio<span class="text-accent">manager</span></span>
      </a>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-ink-2">{t.tagline}</p>
      <a href={route(page, other)} hreflang={other} lang={other} class="mt-5 inline-flex items-center gap-2 rounded-full border border-line-strong px-3 py-1.5 text-sm text-ink-2 hover:text-ink">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"></path></svg>
        {UI[lang].langSwitch}
      </a>
    </div>
    <div>
      <h2 class="text-xs font-semibold uppercase tracking-[0.12em] text-muted">{t.product}</h2>
      <ul class="mt-4 space-y-2.5 text-sm text-ink-2">
        <li><a class="hover:text-ink" href={APP_LOGIN}>{t.app}</a></li>
        <li><a class="hover:text-ink" href={`${route("home", lang)}#features`}>{UI[lang].nav.features}</a></li>
        <li><a class="hover:text-ink" href={`${route("home", lang)}#faq`}>{UI[lang].nav.faq}</a></li>
      </ul>
    </div>
    <div>
      <h2 class="text-xs font-semibold uppercase tracking-[0.12em] text-muted">{t.guides}</h2>
      <ul class="mt-4 space-y-2.5 text-sm text-ink-2">
        {guides.map((g) => <li><a class="hover:text-ink" href={g.href}>{g.label}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="text-xs font-semibold uppercase tracking-[0.12em] text-muted">{t.project}</h2>
      <ul class="mt-4 space-y-2.5 text-sm text-ink-2">
        <li><a class="hover:text-ink" href={route("privacy", lang)}>{t.privacy}</a></li>
        <li><a class="hover:text-ink" href={REPO_URL} rel="noopener">{t.source}</a></li>
      </ul>
    </div>
  </div>
  <div class="mx-auto max-w-6xl border-t border-line px-5 py-8 text-xs leading-relaxed text-muted sm:px-8">
    <p>{t.disclaimer}</p>
    <p class="mt-3">© {year} portfoliomanager</p>
  </div>
</footer>

---
import demo from "../data/demo.json";
import { UI } from "../content/copy";
import { PAGES } from "../content/pages";
import Base from "../layouts/Base.astro";
import { absolute, APP_LOGIN, href, money, route, ROUTES, signedPct, type Lang, type RouteKey } from "../lib/site";
import Icon from "./Icon.astro";

interface Props {
  lang: Lang;
  page: Exclude<RouteKey, "home">;
}
const { lang, page } = Astro.props;
const p = PAGES[page][lang];
const ui = UI[lang];

// Demo numbers quoted in the copy.
const tax25 = demo.tax.find((y) => y.year === 2025)!;
const end = (xs: number[][]) => xs[xs.length - 1][1];
const vars: Record<string, string> = {
  ttm: money(demo.dividends.ttmNet, lang),
  total: money(demo.dividends.totalNet, lang),
  revenue: money(tax25.revenue, lang, 2),
  cost: money(tax25.cost, lang, 2),
  income: money(tax25.income, lang, 2),
  tax: money(tax25.tax, lang),
  div: money(tax25.divToPay, lang),
  twr: signedPct(demo.timeline[demo.timeline.length - 1][3] as number, lang, 1),
  sp: signedPct(end(demo.benchmarks["S&P 500"] as number[][]), lang, 1),
  ndx: signedPct(end(demo.benchmarks["Nasdaq-100"] as number[][]), lang, 1),
};
const fill = (s: string) => s.replace(/\{(\w+)\}/g, (_, k: string) => vars[k] ?? `{${k}}`);

const home = lang === "en" ? "Home" : "Strona główna";
const jsonLd: object[] = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: home, item: absolute(ROUTES.home[lang]) },
      { "@type": "ListItem", position: 2, name: p.crumb, item: absolute(ROUTES[page][lang]) },
    ],
  },
];
if (p.faq?.length)
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: p.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  });
---
<Base lang={lang} page={page} title={p.title} description={p.description} jsonLd={jsonLd}>
  <article class="mx-auto max-w-4xl px-5 pt-32 sm:px-8 sm:pt-40">
    <nav aria-label={lang === "en" ? "Breadcrumb" : "Ścieżka"} class="text-sm text-muted">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href={route("home", lang)} class="hover:text-ink">{home}</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-ink-2">{p.crumb}</li>
      </ol>
    </nav>
    <header class="mt-8">
      <p class="eyebrow">{p.eyebrow}</p>
      <h1 class="mt-3 text-[clamp(36px,6vw,64px)] font-semibold leading-[1.04] tracking-[-0.045em]">{p.h1}</h1>
      <p class="mt-5 max-w-3xl text-lg leading-relaxed text-ink-2">{fill(p.lead)}</p>
      {
        page !== "privacy" && (
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={APP_LOGIN} class="btn btn-primary px-6 py-3 text-[15px]">
              {ui.cta.start} <Icon name="arrow" size={18} />
            </a>
            <a href={`${route("home", lang)}#demo`} class="btn btn-ghost px-6 py-3 text-[15px]">
              {ui.cta.demo}
            </a>
          </div>
        )
      }
    </header>
  </article>

  {
    p.image && (
      <figure class="mx-auto mt-14 max-w-6xl px-5 sm:px-8">
        <div class="glass-float overflow-hidden rounded-[24px] p-2 sm:p-3">
          <img
            src={href(`/img/${p.image.src}-1600.webp`)}
            srcset={`${href(`/img/${p.image.src}-960.webp`)} 960w, ${href(`/img/${p.image.src}-1600.webp`)} 1600w`}
            sizes="(min-width: 1200px) 1140px, 100vw"
            width="1600"
            height="1000"
            alt={p.image.alt}
            loading="eager"
            decoding="async"
            class="block h-auto w-full rounded-[16px]"
          />
        </div>
        <figcaption class="mt-3 text-center text-xs text-muted">{p.image.caption}</figcaption>
      </figure>
    )
  }

  <div class="mx-auto max-w-3xl px-5 pt-16 sm:px-8">
    {
      p.sections.map((s) => (
        <section data-reveal class="mt-12 first:mt-0">
          <h2 class="text-[clamp(24px,3vw,32px)] font-semibold tracking-[-0.03em]">{s.h2}</h2>
          {s.p?.map((t) => (
            <p class="mt-4 text-[17px] leading-relaxed text-ink-2">{fill(t)}</p>
          ))}
          {s.list && (
            <ul class="mt-5 space-y-3">
              {s.list.map((t) => (
                <li class="flex items-start gap-3 text-[16px] leading-relaxed text-ink-2">
                  <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-accent-soft text-accent">
                    <Icon name="check" size={12} stroke={3} />
                  </span>
                  {fill(t)}
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    }

    {
      p.faq && (
        <section class="mt-16">
          <h2 data-reveal class="text-[clamp(24px,3vw,32px)] font-semibold tracking-[-0.03em]">{lang === "en" ? "Questions" : "Pytania"}</h2>
          <div class="mt-6 space-y-3">
            {p.faq.map((f) => (
              <details data-reveal class="glass group px-5 py-1 open:pb-4">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 font-semibold [&::-webkit-details-marker]:hidden">
                  {f.q}
                  <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-white/5 text-muted transition-transform duration-300 group-open:rotate-45">
                    <Icon name="plus" size={15} stroke={2.4} />
                  </span>
                </summary>
                <p class="text-[15px] leading-relaxed text-ink-2">{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      )
    }
  </div>

  <section class="mx-auto max-w-6xl px-5 pt-20 sm:px-8">
    <h2 data-reveal class="text-sm font-semibold uppercase tracking-[0.12em] text-muted">{lang === "en" ? "Keep reading" : "Czytaj dalej"}</h2>
    <ul class="mt-5 grid gap-4 md:grid-cols-3">
      {
        p.related.map((k, i) => (
          <li data-reveal style={`--d:${i * 90}`}>
            <a href={route(k, lang)} class="glass group flex h-full flex-col p-6 transition-transform hover:-translate-y-0.5">
              <span class="eyebrow">{PAGES[k as Exclude<RouteKey, "home">][lang].eyebrow}</span>
              <span class="mt-3 text-lg font-semibold tracking-[-0.01em]">{PAGES[k as Exclude<RouteKey, "home">][lang].h1}</span>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-accent">
                {lang === "en" ? "Read" : "Czytaj"} <Icon name="arrow" size={15} class="transition-transform group-hover:translate-x-0.5" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-6xl px-5 pt-20 sm:px-8">
    <div data-reveal class="glass-float relative overflow-hidden rounded-[32px] px-6 py-12 text-center">
      <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-[radial-gradient(50%_70%_at_50%_0%,rgba(123,99,245,.35),transparent_70%)]"></div>
      <p class="relative text-2xl font-semibold tracking-[-0.02em]">{lang === "en" ? "Free for every XTB investor." : "Za darmo dla każdego inwestora XTB."}</p>
      <a href={APP_LOGIN} class="btn btn-primary relative mt-6 px-6 py-3 text-[15px]">
        {ui.cta.start} <Icon name="arrow" size={18} />
      </a>
    </div>
  </section>
</Base>

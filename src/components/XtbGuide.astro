---
// Animated walk-through of downloading the XTB report in xStation, after the guide in the app's import window
// (src/components/XtbExportGuide.tsx in the app). One SVG, so it scales with the column; src/scripts/motion.ts
// switches the scene and moves the highlight and the cursor to each step's control.
import demo from "../data/demo.json";
import { GUIDE } from "../content/copy";
import type { Lang } from "../lib/site";
import Icon from "./Icon.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const g = GUIDE[lang];
const m = g.mock;

// xStation-like palette for the platform screens, as in the app's guide.
const X = { page: "#15191d", panel: "#1d2328", raised: "#262d33", line: "#323a41", text: "#e8eaed", muted: "#98a1a9", green: "#13a25b", greenSoft: "#1d4a35" };

const dmy = (iso: string) => iso.split("-").reverse().join(".");
const shift = (iso: string, days: number) => new Date(Date.parse(`${iso}T12:00:00Z`) + days * 864e5).toISOString().slice(0, 10);
const today = dmy(demo.asOf);
const monthAgo = dmy(shift(demo.asOf, -30));
const previous = dmy(shift(demo.asOf, -3));
const accounts = [
  ["PLN", "0001"],
  ["USD", "0002"],
  ["IKE", "0003"],
];
const zipName = `90100001_90100002_90100003_2006-01-01_${demo.asOf}.zip`;

// The control of each step in viewBox units: x, y, width, height. The same boxes are drawn below.
const BOX = {
  "tab-history": [78, 130, 128, 20],
  "sub-cash": [130, 162, 116, 20],
  "preset-all": [20, 336, 70, 18],
  export: [560, 160, 66, 24],
  "new-report": [384, 330, 92, 26],
  accounts: [160, 160, 320, 88],
  generate: [384, 330, 92, 26],
  download: [446, 98, 22, 22],
  drop: [40, 30, 560, 340],
} as const;
const STEPS = (
  [
    ["history", "tab-history", ""],
    ["history", "sub-cash", "hist"],
    ["history", "preset-all", "hist cash picker"],
    ["history", "export", "hist cash all"],
    ["reports", "new-report", "hist cash all"],
    ["newReport", "accounts", "hist cash all"],
    ["newReport", "generate", "hist cash all checked"],
    ["reportsReady", "download", "hist cash all ready"],
    ["upload", "drop", "zip"],
  ] as const
).map(([scene, target, flags], i) => ({ scene, flags, box: BOX[target], ...g.steps[i] }));
const [bx, by, bw, bh] = STEPS[0].box;
const bars = [40, 55, 48, 62, 58, 71, 66, 74, 69, 80, 77, 86, 82, 90];
const fields = [
  { label: m.from, value: "", cal: true },
  { label: m.to, value: today, cal: true },
  { label: m.type, value: m.allTypes, cal: false },
  { label: m.instrument, value: m.anyInstrument, cal: false },
];
---
<div class="grid grid-cols-[minmax(0,1fr)] gap-6 md:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)]" data-guide data-scene="history" data-flags="" data-step-ms="2800">
  <div>
    <div class="glass-float rounded-[24px] p-2 sm:p-3">
      <svg viewBox="0 0 640 400" class="block h-auto w-full rounded-[16px]" aria-hidden="true">
        <!-- platform: chart on top, account history panel below -->
        <g class="layer l-platform">
          <rect width="640" height="400" fill={X.page}></rect>
          {bars.map((h, i) => <rect x={24 + i * 43} y={110 - h} width="33" height={h} rx="2" fill={i % 3 ? "#1f6f4a" : "#7a2f35"} />)}
          <rect y="118" width="640" height="282" fill={X.panel}></rect>
          <g font-size="11" text-anchor="middle">
            <text x="43" y="144" fill={X.muted}>{m.charts}</text>
            <rect class="on-hist" x="78" y="130" width="128" height="20" rx="5" fill={X.raised}></rect>
            <text x="142" y="144" fill={X.text}>{m.history} ✕</text>
            <text x="252" y="144" fill={X.muted}>{m.news}</text>
            <text x="303" y="144" fill={X.muted}>+</text>
          </g>
          <rect x="14" y="160" width="300" height="24" rx="12" fill={X.page}></rect>
          <rect class="on-hist off-cash" x="18" y="162" width="108" height="20" rx="10" fill={X.raised}></rect>
          <rect class="on-cash" x="130" y="162" width="116" height="20" rx="10" fill={X.raised}></rect>
          <g font-size="10.5" text-anchor="middle" fill={X.text}>
            <text x="72" y="176">{m.closed}</text>
            <text x="188" y="176">{m.cash}</text>
            <text x="278" y="176">{m.orders}</text>
          </g>
          <rect x="560" y="160" width="66" height="24" rx="6" fill="none" stroke={X.line}></rect>
          <path d="M572 165v8M568.5 170l3.5 3.5 3.5-3.5M567 177h10" fill="none" stroke={X.text} stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
          <text x="582" y="176" font-size="10.5" font-weight="700" fill={X.text}>{m.export}</text>
          {
            fields.map((f, i) => (
              <g>
                <text x={14 + i * 152} y="203" font-size="9" fill={X.muted}>
                  {f.label}
                </text>
                <rect x={14 + i * 152} y="208" width="144" height="22" rx="5" fill={X.panel} stroke={X.line} />
                {f.value && (
                  <text x={21 + i * 152} y="223" font-size="10" fill={X.text}>
                    {f.value}
                  </text>
                )}
                {f.cal && <path d={`M${142 + i * 152} 214h9v9h-9zM${142 + i * 152} 217h9`} fill="none" stroke={X.muted} stroke-width="1" />}
              </g>
            ))
          }
          <text class="off-all" x="21" y="223" font-size="10" fill={X.text}>{monthAgo}</text>
          <text class="on-all" x="21" y="223" font-size="10" fill={X.text}>01.01.2006</text>
          {[0, 1, 2, 3, 4, 5].map((r) => <rect x="14" y={244 + r * 22} width="612" height="12" rx="3" fill={X.raised} opacity={0.6 - r * 0.09} />)}
          <g class="on-picker">
            <rect x="14" y="236" width="272" height="132" rx="8" fill={X.panel} stroke={X.line}></rect>
            {
              m.presets.map((p, i) => (
                <text x="26" y={256 + i * 17} font-size="9.5" fill={X.muted}>
                  {p}
                </text>
              ))
            }
            <rect x="20" y="336" width="70" height="18" rx="9" fill={X.greenSoft}></rect>
            <text x="55" y="349" text-anchor="middle" font-size="9.5" font-weight="700" fill={X.text}>{m.all}</text>
            {
              Array.from({ length: 28 }, (_, i) => (
                <g>
                  <rect x={112 + (i % 7) * 24} y={250 + Math.floor(i / 7) * 24} width="18" height="18" rx="3" fill={i === 6 ? X.green : X.greenSoft} />
                  <text x={121 + (i % 7) * 24} y={262 + Math.floor(i / 7) * 24} text-anchor="middle" font-size="8" fill={X.text}>
                    {i + 1}
                  </text>
                </g>
              ))
            }
          </g>
        </g>

        <!-- report list: the earlier report, then the new one on top -->
        <g class="layer l-reports">
          <rect width="640" height="400" fill="#000" opacity="0.5"></rect>
          <rect x="150" y="30" width="340" height="340" rx="14" fill={X.panel}></rect>
          <text x="166" y="60" font-size="14" font-weight="700" fill={X.text}>{m.reports}</text>
          <path d="M466 52l8 8M474 52l-8 8" stroke={X.muted} stroke-width="1.5" stroke-linecap="round"></path>
          <g font-size="9" fill={X.muted}>
            <text x="166" y="86">{m.account}</text>
            <text x="296" y="86">{m.from}</text>
            <text x="372" y="86">{m.to}</text>
          </g>
          {
            [today, previous].map((to, r) => (
              <g class={r === 0 ? "on-ready" : "shift-ready"}>
                {accounts.map(([ccy, nr], i) => (
                  <text x="166" y={106 + i * 14} font-size="10" fill={X.text}>
                    {ccy} #••••{nr}
                  </text>
                ))}
                <text x="296" y="120" font-size="10" fill={X.text}>01.01.2006</text>
                <text x="372" y="120" font-size="10" fill={X.text}>{to}</text>
                <path d="M457 103v9M453 108.5l4 4 4-4M452 116h10" fill="none" stroke={X.green} stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                <line x1="166" x2="474" y1="146" y2="146" stroke={X.line} />
              </g>
            ))
          }
          <rect x="384" y="330" width="92" height="26" rx="13" fill={X.green}></rect>
          <text x="430" y="347" text-anchor="middle" font-size="10" font-weight="700" fill="#fff">{m.newReport}</text>
        </g>

        <!-- new report: dates and accounts -->
        <g class="layer l-new">
          <rect width="640" height="400" fill="#000" opacity="0.5"></rect>
          <rect x="150" y="30" width="340" height="340" rx="14" fill={X.panel}></rect>
          <path d="M172 54l-5 5 5 5M167 59h11" fill="none" stroke={X.text} stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
          <text x="186" y="64" font-size="14" font-weight="700" fill={X.text}>{m.newReport}</text>
          <text x="166" y="92" font-size="10.5" font-weight="700" fill={X.text}>{m.date}</text>
          {
            [
              [m.from, "01.01.2006"],
              [m.to, today],
            ].map(([label, value], i) => (
              <g>
                <text x={166 + i * 158} y="108" font-size="9" fill={X.muted}>
                  {label}
                </text>
                <rect x={166 + i * 158} y="112" width="150" height="22" rx="5" fill={X.panel} stroke={X.line} />
                <text x={173 + i * 158} y="127" font-size="10" fill={X.text}>
                  {value}
                </text>
              </g>
            ))
          }
          <text x="166" y="156" font-size="10.5" font-weight="700" fill={X.text}>{m.accounts}</text>
          {
            accounts.map(([ccy, nr], i) => (
              <g>
                <rect x="166" y={166 + i * 28} width="12" height="12" rx="2.5" fill="none" stroke={X.muted} />
                <g class="on-checked" style={`transition-delay:${i * 140}ms`}>
                  <rect x="166" y={166 + i * 28} width="12" height="12" rx="2.5" fill={X.green} />
                  <path d={`M169 ${172 + i * 28}l2.5 2.5 4.5-5`} fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </g>
                <rect x="186" y={165 + i * 28} width="28" height="14" rx="7" fill={X.raised} />
                <text x="200" y={175 + i * 28} text-anchor="middle" font-size="8" font-weight="700" fill={X.text}>
                  {ccy}
                </text>
                <text x="222" y={176 + i * 28} font-size="10" fill={X.text}>
                  #••••{nr}
                </text>
                {i === 0 && (
                  <text x="290" y={176 + i * 28} font-size="9" font-weight="700" fill={X.text}>
                    {m.current}
                  </text>
                )}
                <line x1="166" x2="474" y1={186 + i * 28} y2={186 + i * 28} stroke={X.line} />
              </g>
            ))
          }
          <rect x="292" y="330" width="84" height="26" rx="13" fill={X.raised}></rect>
          <text x="334" y="347" text-anchor="middle" font-size="10" font-weight="700" fill={X.text}>{m.cancel}</text>
          <rect x="384" y="330" width="92" height="26" rx="13" fill={X.green}></rect>
          <text x="430" y="347" text-anchor="middle" font-size="10" font-weight="700" fill="#fff">{m.generate}</text>
        </g>

        <!-- portfoliomanager: the .zip dropped as it is -->
        <g class="layer l-upload">
          <rect width="640" height="400" fill="var(--page)"></rect>
          <rect x="40" y="30" width="560" height="340" rx="18" fill="var(--surface)" stroke="var(--border-strong)" stroke-width="2" stroke-dasharray="8 6"></rect>
          <rect x="296" y="104" width="48" height="48" rx="12" fill="var(--accent-soft)"></rect>
          <path d="M329 137v4a2 2 0 0 1-2 2h-14a2 2 0 0 1-2-2v-4M325 122l-5-5-5 5M320 117v14" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          <text x="320" y="182" text-anchor="middle" font-size="14" font-weight="600" fill="var(--text)">{m.drop}</text>
          <g class="on-zip zip-in">
            <rect x="110" y="202" width="420" height="30" rx="8" fill="var(--surface-2)" stroke="var(--border-strong)"></rect>
            <path d="M125 209h7l4 4v12h-11zM128 212v2M128 216v2M128 220v2" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linejoin="round"></path>
            <text x="144" y="221" font-size="10.5" fill="var(--text)">{zipName}</text>
          </g>
          <g class="on-zip zip-done" font-size="11.5" font-weight="600" fill="var(--gain)">
            <text x="320" y="262" text-anchor="middle">✓ {m.loaded}</text>
          </g>
          <g class="on-zip zip-done">
            {
              accounts.map(([ccy], i) => (
                <g>
                  <rect x={254 + i * 46} y="276" width="40" height="18" rx="9" fill="var(--accent-soft)" />
                  <text x={274 + i * 46} y="289" text-anchor="middle" font-size="9.5" font-weight="700" fill="var(--accent-2)">
                    {ccy}
                  </text>
                </g>
              ))
            }
          </g>
        </g>

        <!-- highlight, step number and cursor (moved by motion.ts) -->
        <rect data-guide-ring x={bx - 4} y={by - 4} width={bw + 8} height={bh + 8} rx="8" fill="none" stroke="var(--accent)" stroke-width="2.5"></rect>
        <g data-guide-badge transform={`translate(${bx - 4} ${by - 4})`}>
          <circle r="9" fill="var(--accent)"></circle>
          <text y="3.5" text-anchor="middle" font-size="10" font-weight="700" fill="#0d0b26">1</text>
        </g>
        <g data-guide-cursor transform={`translate(${bx + bw * 0.6} ${by + bh * 0.6})`}>
          <circle data-guide-click class="g-click" r="12" fill="#fff"></circle>
          <path d="M0 0l15 8.5-6.5 1.8L5.6 17z" fill="#fff" stroke="#111" stroke-width="1.3" stroke-linejoin="round"></path>
        </g>
      </svg>
    </div>
    <div class="mt-3 flex items-center justify-between gap-3 px-1">
      <p class="text-xs text-muted">{g.note}</p>
      <button
        type="button"
        data-guide-toggle
        data-play={g.play}
        data-pause={g.pause}
        aria-label={g.pause}
        class="guide-toggle h-9 w-9 shrink-0 items-center justify-center rounded-full border border-line-strong text-ink-2 transition-colors hover:bg-white/5 hover:text-ink"
      >
        <span data-icon="pause"><Icon name="pause" size={15} stroke={2.4} /></span>
        <span data-icon="play" hidden><Icon name="play" size={15} stroke={2.2} /></span>
      </button>
    </div>
  </div>

  <ol class="space-y-1 self-start text-[15px]">
    {
      STEPS.map((s, i) => (
        <li>
          <button
            type="button"
            data-guide-step
            data-scene={s.scene}
            data-flags={s.flags}
            data-box={s.box.join(" ")}
            aria-current={i === 0 ? "step" : undefined}
            class="step flex w-full gap-3 rounded-2xl px-3 py-2 text-left transition-colors hover:bg-white/5"
          >
            <span class="num tabular mt-px flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-surface-2 text-xs font-semibold text-ink-2">{i + 1}</span>
            <span class="min-w-0">
              <span class="title block text-ink-2">{s.t}</span>
              {s.d && <span class="detail mt-0.5 block text-[13px] leading-snug text-ink-2">{s.d}</span>}
            </span>
          </button>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .layer {
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .l-platform,
  [data-scene="reports"] .l-reports,
  [data-scene="reportsReady"] .l-reports,
  [data-scene="newReport"] .l-new,
  [data-scene="upload"] .l-upload {
    opacity: 1;
  }
  [data-scene="upload"] .l-platform {
    opacity: 0;
  }

  /* Per-step details: data-flags on the root says which ones are on. */
  .on-hist,
  .on-cash,
  .on-picker,
  .on-all,
  .on-checked,
  .on-ready,
  .on-zip,
  .off-all {
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .off-all,
  [data-flags~="hist"] .on-hist,
  [data-flags~="cash"] .on-cash,
  [data-flags~="picker"] .on-picker,
  [data-flags~="all"] .on-all,
  [data-flags~="checked"] .on-checked,
  [data-flags~="ready"] .on-ready,
  [data-flags~="zip"] .on-zip {
    opacity: 1;
  }
  [data-flags~="cash"] .off-cash,
  [data-flags~="all"] .off-all {
    opacity: 0;
  }
  .on-ready {
    transition-delay: 0.25s;
  }
  .shift-ready {
    transition: transform 0.45s var(--ease-liquid);
  }
  [data-flags~="ready"] .shift-ready {
    transform: translateY(54px);
  }
  .zip-in {
    transform: translateY(-14px);
    transition:
      opacity 0.4s ease 0.5s,
      transform 0.6s var(--ease-spring) 0.5s;
  }
  [data-flags~="zip"] .zip-in {
    transform: none;
  }
  .zip-done {
    transition-delay: 1.2s;
  }

  .g-click {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }
  .g-click.go {
    animation: g-click 0.6s ease-out;
  }
  @keyframes g-click {
    from {
      opacity: 0.55;
      transform: scale(0.3);
    }
    to {
      opacity: 0;
      transform: scale(1.7);
    }
  }

  /* Step list: the current step is highlighted and shows its detail (all details show without JS). */
  .step[aria-current="step"] {
    background: var(--accent-soft);
  }
  .step[aria-current="step"] .num {
    background: var(--accent);
    color: #0d0b26;
  }
  .step[aria-current="step"] .title {
    font-weight: 600;
    color: var(--text);
  }
  :global(.js) .step:not([aria-current]) .detail {
    display: none;
  }
  .guide-toggle {
    display: none;
  }
  :global(.js) .guide-toggle {
    display: inline-flex;
  }
</style>

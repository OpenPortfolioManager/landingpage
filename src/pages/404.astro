---
import "../styles/global.css";
import Logo from "../components/Logo.astro";
import { href, route } from "../lib/site";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found · portfoliomanager</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href={href("/favicon.svg")} type="image/svg+xml" />
  </head>
  <body class="flex min-h-dvh items-center justify-center px-5">
    <main class="glass-float max-w-md rounded-[32px] p-10 text-center">
      <Logo class="mx-auto h-10 w-auto" />
      <p class="mt-6 text-5xl font-semibold tracking-[-0.04em]">404</p>
      <p class="mt-3 text-ink-2">This page does not exist. <span lang="pl">Ta strona nie istnieje.</span></p>
      <div class="mt-8 flex justify-center gap-3">
        <a href={route("home", "en")} class="btn btn-primary px-5 py-2.5 text-sm">Home</a>
        <a href={route("home", "pl")} class="btn btn-ghost px-5 py-2.5 text-sm" lang="pl">Strona główna</a>
      </div>
    </main>
  </body>
</html>
